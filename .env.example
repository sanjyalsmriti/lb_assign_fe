# Base URL for the API client. Defaults to the built-in mock at /api.
# Point this at the real backend to stop using the mock.
NEXT_PUBLIC_API_BASE_URL=/api

# Average mock response delay in ms (actual delay is 50%–150% of this).
MOCK_DELAY_MS=600

# Chance (0–1) that any mock request fails with a 500.
MOCK_FAILURE_RATE=0
